# Copy to .env. No secrets are required for the default pipeline.
# Optional: Hugging Face token, only if a model download needs authentication.
HF_TOKEN=
# Optional: local cache for downloaded models (predict never downloads).
HF_HOME=
# Set to 0 to force CPU at predict time.
TERMMAP_USE_GPU=1
# Torch/LightGBM CPU threads (fixed for determinism; record it when reporting results).
TERMMAP_THREADS=8
