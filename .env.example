# Copy to .env and edit. No secrets are required to run TermMap.
# 1 = use CUDA when available (default), 0 = force CPU
TERMMAP_USE_GPU=1
# torch CPU threads
TERMMAP_THREADS=8
# Optional: Hugging Face cache location (models are downloaded once at build/train time)
# HF_HOME=
# Optional: only needed if a gated model is ever configured (the default models are public)
# HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
